{
  "expo": {
    "name": "SaveCents",
    "slug": "savecents",
    "scheme": "savecents",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#040906",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rxsfin.savecents",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SaveCents uses the microphone for voice expense logging.",
        "NSCameraUsageDescription": "SaveCents uses the camera to scan receipts and price tags."
      }
    },
    "android": {
      "package": "com.rxsfin.savecents",
      "adaptiveIcon": {
        "backgroundColor": "#040906",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SaveCents uses the camera to scan receipts and price tags."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}